# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Env / secrets ---
.env
.env.*
!.env.example
*.p12
*.pem

# --- Logs ---
*.log
