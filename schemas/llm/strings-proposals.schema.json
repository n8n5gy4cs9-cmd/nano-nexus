{
  "$comment": "User-facing string improvements / i18n keys (prompts/internal/strings_improve.md). Rust validates: placeholders identical (multiset), max_len respected, key unique.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": { "type": "array", "minItems": 1, "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "type": "string", "maxLength": 16 },
        "improved": { "type": "string", "maxLength": 500 },
        "key": { "type": "string", "maxLength": 64, "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$" }
      } } }
  }
}
