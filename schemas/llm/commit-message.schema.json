{
  "$comment": "Conventional Commits 1.0.0 message parts (prompts/internal/commit_message.md). Rust renders: type(scope)!: subject \\n\\n body \\n\\n BREAKING CHANGE footer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "scope", "subject", "body", "breaking"],
  "properties": {
    "type": { "type": "string", "enum": ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"] },
    "scope": { "type": "string", "maxLength": 24, "pattern": "^[a-z0-9_./-]*$" },
    "subject": { "type": "string", "minLength": 3, "maxLength": 72 },
    "body": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 100 } },
    "breaking": { "type": "boolean" }
  }
}
