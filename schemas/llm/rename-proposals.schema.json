{
  "$comment": "Rename proposals for one batch (prompts/internal/rename_propose.md). At runtime: proposals.items.properties.id.enum = the batch's symbol ids; new_name.pattern = the convention regex for the batch kind (see patterns below). Rust then validates keywords, collisions, deny lists.",
  "x-nexus-patterns": {
    "snake_case": "^_?[a-z][a-z0-9]*(_[a-z0-9]+)*$",
    "PascalCase": "^[A-Z][a-zA-Z0-9]*$",
    "camelCase": "^[a-z][a-zA-Z0-9]*$",
    "CONSTANT_CASE": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": { "type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "new_name", "confidence", "reason"],
      "properties": {
        "id": { "type": "string", "enum": ["s1"] },
        "new_name": { "type": "string", "minLength": 2, "maxLength": 48, "pattern": "^_?[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string", "maxLength": 120 }
      } } }
  }
}
