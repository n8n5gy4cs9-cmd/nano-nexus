{
  "$comment": "MAP step notes for one document chunk (prompts/internal/doc_map.md). Rust checks that page numbers fall inside the chunk's page range.",
  "type": "object",
  "additionalProperties": false,
  "required": ["points", "numbers", "terms"],
  "properties": {
    "points": { "type": "array", "minItems": 1, "maxItems": 6, "items": {
      "type": "object", "additionalProperties": false, "required": ["text", "page"],
      "properties": { "text": { "type": "string", "maxLength": 300 }, "page": { "type": "integer", "minimum": 1 } } } },
    "numbers": { "type": "array", "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false, "required": ["label", "value", "page"],
      "properties": { "label": { "type": "string", "maxLength": 80 }, "value": { "type": "string", "maxLength": 60 }, "page": { "type": "integer", "minimum": 1 } } } },
    "terms": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 60 } }
  }
}
