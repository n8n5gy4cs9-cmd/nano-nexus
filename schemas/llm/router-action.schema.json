{
  "$comment": "Router decision (ADR-003/004). The action enum is rebuilt at runtime from the assistant's allowed tools + 'answer'. Flat on purpose: small models + GBNF grammar handle flat objects best.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": { "type": "string", "enum": ["answer", "read_file", "list_dir", "search_files", "grep_text", "scan_folder", "file_info", "doc_search", "calculate", "now", "write_file", "edit_file", "move_file", "trash_file", "search_web", "fetch_url"] },
    "path": { "type": "string", "maxLength": 1024 },
    "query": { "type": "string", "maxLength": 200 },
    "expression": { "type": "string", "maxLength": 200 },
    "content": { "type": "string", "maxLength": 12000 },
    "old_text": { "type": "string", "maxLength": 4000 },
    "new_text": { "type": "string", "maxLength": 12000 },
    "to": { "type": "string", "maxLength": 1024 },
    "url": { "type": "string", "maxLength": 2048 }
  }
}
