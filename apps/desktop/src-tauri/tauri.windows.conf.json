{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NanoNexus",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "none",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
